# ==============================================================================
# .agentignore - Archivos y directorios ignorados por agentes de Inteligencia Artificial
# ==============================================================================

# Dependencias y paquetes externos
node_modules/
bun.lock
package-lock.json
yarn.lock
pnpm-lock.yaml

# Salida de compilación y artefactos generados
dist/
build/
out/
.astro/

# Control de versiones y metadatos de Git
.git/
.github/

# Archivos de entorno y credenciales sensibles
.env
.env.production
.env.local
.env.*.local
*.pem
*.key

# Registros y logs de ejecución
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Configuraciones de IDE y editores locales
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Archivos de sistema operativo
.DS_Store
Thumbs.db
